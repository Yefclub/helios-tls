# ============================================================
#  Helios TLS Manager — variáveis de ambiente (copie p/ .env)
# ============================================================

# --- Acesso ao painel ---
APP_USER=admin
APP_PASSWORD=troque-esta-senha-forte
SECRET_KEY=gere-uma-string-aleatoria-bem-longa
SERVER_LABEL=helios

# --- Let's Encrypt (curinga via DNS-01) ---
LE_EMAIL=voce@seudominio.com
LE_DOMAIN=*.seudominio.com
# zonas extras (apex ou curinga), separadas por vírgula — não substituem LE_DOMAIN
# LE_DOMAINS=rastrofit.com,outro.com
# zona que vira o catch-all do Traefik (padrão: a de LE_DOMAIN)
# LE_DEFAULT_ZONE=seudominio.com
# resolvers públicos usados na checagem de propagação
# (necessário quando o DNS da máquina é interno/split-horizon)
LE_RESOLVERS=1.1.1.1:53,8.8.8.8:53

# --- Cloudflare ---
# Token de API com escopo: Zone.DNS = Edit  +  Zone.Zone = Read (na zona alvo)
CLOUDFLARE=seu-token-de-api-da-cloudflare

# --- Comportamento ---
# instala o curinga também como certificado PADRÃO (catch-all) do Traefik
SET_DEFAULT=true
# liga o agendador de auto-renovação (renova quando faltam <30 dias)
RUN_SCHEDULER=true
# marca o cookie de sessão como Secure — ligue quando o painel for servido por HTTPS
COOKIE_SECURE=false

# --- API de distribuição do certificado (opcional) ---
# token compartilhado p/ outras apps internas baixarem o cert via /api/cert/*
# vazio = endpoints DESLIGADOS. Gere algo aleatório e longo.
CERT_API_TOKEN=

# --- Avançado (geralmente não precisa mexer) ---
# pasta do Traefik montada no container (bind /etc/easypanel/traefik:/data)
# DATA_DIR=/data
